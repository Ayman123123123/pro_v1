<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Younes" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/younes_obsidian</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/younes_emerald</item>
        <item name="android:windowBackground">@color/younes_obsidian</item>
        <item name="android:windowSplashScreenBackground">@color/younes_obsidian</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">650</item>
    </style>
</resources>
