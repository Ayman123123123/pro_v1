<?xml version="1.0" encoding="utf-8"?>
<!--
    ▶ YOUNES Sovereign — Voice Player Background
    Played portion in emerald, unplayed in dark
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/yns_surface_elevated" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:angle="0"
                    android:startColor="@color/younes_emerald"
                    android:centerColor="@color/yns_primary"
                    android:endColor="@color/yns_primary_light" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
