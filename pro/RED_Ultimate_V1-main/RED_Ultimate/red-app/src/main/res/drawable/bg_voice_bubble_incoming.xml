<?xml version="1.0" encoding="utf-8"?>
<!--
    💬 YOUNES Sovereign — Voice Bubble Background (Incoming)
    Dark navy with subtle gradient
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/yns_surface_elevated"
        android:centerColor="@color/yns_surface"
        android:endColor="@color/yns_surface_light" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomRightRadius="20dp"
        android:bottomLeftRadius="4dp" />
    <stroke
        android:width="1dp"
        android:color="@color/yns_accent_dark" />
</shape>
