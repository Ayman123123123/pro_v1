<?xml version="1.0" encoding="utf-8"?>
<!--
    💬 YOUNES Sovereign — Voice Bubble Background (Outgoing)
    Emerald gradient
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/younes_emerald"
        android:centerColor="@color/yns_primary"
        android:endColor="@color/yns_primary_dark" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomRightRadius="4dp"
        android:bottomLeftRadius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/yns_primary_light" />
</shape>
