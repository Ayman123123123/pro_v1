{
  "name": "red-admin-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "start": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:check": "tsc --noEmit",
    "build:fast": "vite build",
    "build:strict": "tsc --noEmit && vite build",
    "check": "npm run check:api && npm run check:guards && npm run check:roles && npm run build:check",
    "check:api": "node scripts/check-api-contract.mjs",
    "check:guards": "node scripts/check-frontend-guards.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "check:roles": "node scripts/check-app-roles.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "antd": "^6.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.2.2"
  }
}
