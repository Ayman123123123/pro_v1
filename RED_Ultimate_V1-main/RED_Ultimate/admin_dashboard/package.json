{
  "name": "red-admin-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8088",
    "start": "vite --host 0.0.0.0 --port 8088",
    "mock": "node mock-backend.cjs",
    "build": "tsc --noEmit && vite build",
    "build:check": "tsc --noEmit",
    "build:fast": "vite build",
    "build:strict": "tsc --noEmit && vite build",
    "check": "npm run check:api && npm run check:guards && npm run build:check",
    "check:api": "node scripts/check-api-contract.mjs",
    "check:guards": "node scripts/check-frontend-guards.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8088"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "antd": "^6.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
