{
  "name": "red-admin-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "start": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit --skipLibCheck && vite build",
    "build:check": "tsc --noEmit --skipLibCheck",
    "build:fast": "vite build",
    "build:strict": "tsc --noEmit --skipLibCheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "check": "tsc --noEmit --skipLibCheck",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "antd": "^6.1.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "i18next": "^24.2.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.2",
    "vite": "^7.0.0",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^2.1.5"
  }
}