{
  "dashboard": {
    "title": "RED Sovereign - VoiceBridge Overview",
    "uid": "red-sovereign-voicebridge",
    "tags": ["red-sovereign", "voicebridge", "ai", "telephony"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Calls",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "voicebridge_active_calls",
            "legendFormat": "Active Calls",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "Calls per Second",
        "type": "graph",
        "gridPos": {"x": 6, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(voicebridge_calls_total[5m])",
            "legendFormat": "Calls/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Call Duration Distribution",
        "type": "heatmap",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "voicebridge_call_duration_seconds_bucket",
            "format": "heatmap",
            "legendFormat": "{{le}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Barge-in Events",
        "type": "graph",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(voicebridge_barge_in_total[5m])",
            "legendFormat": "Barge-in/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "DTMF Events",
        "type": "graph",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(voicebridge_dtmf_total[5m])",
            "legendFormat": "DTMF/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "RTP Packet Loss",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(voicebridge_rtp_packet_loss_total[5m])",
            "legendFormat": "Packet Loss/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "ARI Connection Status",
        "type": "stat",
        "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "voicebridge_ari_connected",
            "legendFormat": "Connected",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "Disconnected", "color": "red"}, "1": {"text": "Connected", "color": "green"}}}
            ]
          }
        }
      },
      {
        "id": 8,
        "title": "RTP Jitter Buffer",
        "type": "graph",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "voicebridge_rtp_jitter_buffer_ms",
            "legendFormat": "Jitter (ms)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Bot Response Latency",
        "type": "graph",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(voicebridge_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(voicebridge_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P50 Latency",
            "refId": "B"
          }
        ]
      },
      {
        "id": 10,
        "title": "Call Outcomes",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "voicebridge_calls_total{outcome=\"answered\"}",
            "legendFormat": "Answered",
            "refId": "A"
          },
          {
            "expr": "voicebridge_calls_total{outcome=\"failed\"}",
            "legendFormat": "Failed",
            "refId": "B"
          },
          {
            "expr": "voicebridge_calls_total{outcome=\"busy\"}",
            "legendFormat": "Busy",
            "refId": "C"
          },
          {
            "expr": "voicebridge_calls_total{outcome=\"no_answer\"}",
            "legendFormat": "No Answer",
            "refId": "D"
          }
        ]
      },
      {
        "id": 11,
        "title": "AI Bot Latency Percentiles",
        "type": "table",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(voicebridge_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.90, rate(voicebridge_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P90",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.95, rate(voicebridge_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P95",
            "refId": "C"
          },
          {
            "expr": "histogram_quantile(0.99, rate(voicebridge_bot_latency_seconds_bucket[5m]))",
            "legendFormat": "P99",
            "refId": "D"
          }
        ]
      }
    ]
  },
  "overwrite": true
}