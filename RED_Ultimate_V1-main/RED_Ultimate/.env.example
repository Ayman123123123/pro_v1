# RED Sovereign Platform environment configuration.
# Copy this file to .env and replace every password before deployment.
DB_PASSWORD=replace_with_a_long_random_database_password
MONGO_PASSWORD=replace_with_a_long_random_mongodb_password
MINIO_PASSWORD=replace_with_a_long_random_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PASSWORD=replace_with_a_long_random_redis_password
TURN_SECRET=replace_with_a_long_random_turn_secret
JWT_SECRET=replace_with_at_least_32_random_characters
REFRESH_EXPIRATION_DAYS=30
RED_DEVICE_CERTIFICATE_VALID_DAYS=90
RED_ADMIN_USERNAME=red_admin
RED_ADMIN_PASSWORD=replace_with_at_least_14_random_characters
RED_ADMIN_COOKIE_SECURE=false
RED_HTTP_PORT=8088
RED_HTTPS_PORT=8443
CLIENT_LAN_IP=192.168.0.244
TLS_SAN_IP=192.168.0.244
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://192.168.0.244:8088
RED_TLS_PINS=
TURN_PUBLIC_HOST=192.168.0.244
TURN_PORT=3478
# Phase 10: used by base coturn service + prod override (empty = disabled sections).
TURN_USERNAME=red_turn_user
TURN_PASSWORD=replace_with_a_long_random_turn_password
SIP_REALM=red.sovereign
TURN_INTERNAL_IP=
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_grafana_password
CLOUDFLARE_TUNNEL_TOKEN=
MEDIASOUP_ANNOUNCED_IP=192.168.0.244
MEDIASOUP_WORKERS=2
MEDIASOUP_FORCE_LOCAL_BUILD=
# Sovereign push (UnifiedPush via self-hosted ntfy — no Google push).
NTFY_PORT=2586
NTFY_BASE_URL=http://192.168.0.244:2586
PUSH_ALLOW_HTTP_ENDPOINTS=true
