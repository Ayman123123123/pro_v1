# RED Sovereign Platform environment configuration.
# Copy this file to .env and replace every password before deployment.
DB_PASSWORD=replace_with_a_long_random_database_password
MONGO_PASSWORD=replace_with_a_long_random_mongodb_password
MINIO_PASSWORD=replace_with_a_long_random_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PASSWORD=replace_with_a_long_random_redis_password
TURN_SECRET=replace_with_a_long_random_turn_secret
JWT_SECRET=replace_with_at_least_32_random_characters
REFRESH_EXPIRATION_DAYS=30
RED_DEVICE_CERTIFICATE_VALID_DAYS=90
RED_ADMIN_USERNAME=red_admin
RED_ADMIN_PASSWORD=replace_with_at_least_14_random_characters
RED_ADMIN_COOKIE_SECURE=false
RED_HTTP_PORT=8088
RED_HTTPS_PORT=8443
CLIENT_LAN_IP=192.168.0.244
TLS_SAN_IP=192.168.0.244
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://192.168.0.244:8088
RED_TLS_PINS=
TURN_PUBLIC_HOST=192.168.0.244
TURN_PORT=3478
# Phase 10: used by base coturn service + prod override (empty = disabled sections).
TURN_USERNAME=red_turn_user
TURN_PASSWORD=replace_with_a_long_random_turn_password
SIP_REALM=red.sovereign
TURN_INTERNAL_IP=
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_grafana_password
CLOUDFLARE_TUNNEL_TOKEN=
MEDIASOUP_ANNOUNCED_IP=192.168.0.244
MEDIASOUP_WORKERS=2
MEDIASOUP_FORCE_LOCAL_BUILD=
# Sovereign push (UnifiedPush via self-hosted ntfy — no Google push).
# Host port mapped to the ntfy container (the container itself listens on :80).
NTFY_PORT=2586
# URL a PHONE on the LAN can reach ntfy at - NOT 127.0.0.1 for real devices.
# The distributor hands this host back to the app as its wake endpoint.
NTFY_BASE_URL=http://192.168.0.244:2586
# How long ntfy keeps a wake so a briefly-offline device still receives it.
NTFY_CACHE_DURATION=12h
# LAN distributors serve plain HTTP; the backend must accept http:// endpoints.
PUSH_ALLOW_HTTP_ENDPOINTS=true
# --- Defaults documented from docker-compose.yml (unset = default shown) ---
# OPENRELAY_ENABLED=false
# OPENRELAY_USERNAME=openrelayproject
# OPENRELAY_PASSWORD=openrelayproject
# DB_USER=admin
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=redadmin
# MINIO_BUCKET=red-media
# MINIO_BUCKET_MEDIA=red-media
# MINIO_BUCKET_AVATARS=red-avatars
# MINIO_BUCKET_STORIES=red-stories
# RED_RETENTION_AUDIT_DAYS=365
# RED_RETENTION_CDR_DAYS=365
# RED_RETENTION_HEALTH_DAYS=90
# RED_RETENTION_TELEMETRY_DAYS=90
# RED_RETENTION_BATCH_SIZE=10000
# PUSH_CONNECT_TIMEOUT_MS=5000
# PUSH_READ_TIMEOUT_MS=5000
# PUSH_MAX_RETRIES=2
# PUSH_RETRY_BASE_MS=300
# NTFY_LOG_LEVEL=info
# TURN_EXTERNAL_IP= (empty)
# MEDIASOUP_EXTERNAL_IP= (empty)
# RTC_MIN_PORT=40000
# RTC_MAX_PORT=40100

# Optional dedicated secret for SFU media tickets (falls back to JWT_SECRET when empty)
SFU_TICKET_SECRET=
