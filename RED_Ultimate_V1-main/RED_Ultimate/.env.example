# ══════════════════════════════════════════════════════════════════
# 🏛️ YOUNES Sovereign Platform — Environment Configuration
# Copy this file to .env before running: docker compose up -d
# All passwords MUST be changed for production!
# ══════════════════════════════════════════════════════════════════

# ─── Database Passwords ───
DB_PASSWORD=replace_with_a_long_random_database_password
MONGO_PASSWORD=replace_with_a_long_random_mongodb_password
MINIO_PASSWORD=replace_with_a_long_random_minio_password
# MinIO remains loopback-only; change these only for local port collisions.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PASSWORD=replace_with_a_long_random_redis_password

# ─── Service Passwords ───
AMI_PASSWORD=replace_with_a_long_random_asterisk_password
TURN_SECRET=replace_with_a_long_random_turn_secret

# ─── JWT & Identity ───
JWT_SECRET=replace_with_at_least_32_random_characters
REFRESH_EXPIRATION_DAYS=30
RED_DEVICE_CERTIFICATE_VALID_DAYS=90

# ─── Admin Account ───
RED_ADMIN_USERNAME=red_admin
RED_ADMIN_PASSWORD=replace_with_at_least_14_random_characters
# false for local HTTP on 8088. Set true only when the dashboard is served over TLS.
RED_ADMIN_COOKIE_SECURE=false

# ─── Dinstar UC2000-VE-8G Gateway ───
# Keep the factory management IP on the dedicated NIC (Realtek ↔ UC2000).
# The box has no Wi-Fi: moving it to 192.168.0.x does not survive unplugging
# the cable and mixes the management plane with internet Wi-Fi. Internet
# stays on Wi-Fi. After the box answers ping:
#   powershell -ExecutionPolicy Bypass -File .\scripts\enable-dinstar-ready.ps1
DINSTAR_ENABLED=false
DINSTAR_USERNAME=admin
DINSTAR_PASSWORD=admin
DINSTAR_IP=192.168.11.1
DINSTAR_PORT=443
DINSTAR_SCHEME=https
# Comma-separated management/SIP addresses when several gateways are attached.
# Leave empty to use DINSTAR_IP only. On every UC2000 SIP Server page, target
# this host's dedicated 192.168.11.x NIC on UDP 5060.
DINSTAR_IPS=
# Asterisk NAT is independent from mediasoup. Leave blank on a flat LAN; for a
# routed deployment use the public SIP/RTP address and list private networks.
ASTERISK_EXTERNAL_MEDIA_ADDRESS=
ASTERISK_EXTERNAL_SIGNALING_ADDRESS=
ASTERISK_LOCAL_NET=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# ─── Network & Proxy ───
RED_HTTP_PORT=8088
RED_HTTPS_PORT=8443
# LAN IP embedded in the self-signed development certificate SAN.
TLS_SAN_IP=192.168.1.50
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://192.168.1.50:8088
# Android release SPKI pins: host=sha256/current|sha256/backup;other.host=sha256/pin
# Leave empty for development; platform TLS validation remains active.
RED_TLS_PINS=

# ─── TURN/STUN ───
# Public DNS/IP returned to clients. For 1:1 NAT, set TURN_EXTERNAL_IP to the
# public IP and TURN_INTERNAL_IP to this container host's private IP. If there
# is no 1:1 NAT, leave TURN_INTERNAL_IP empty (coturn must not receive `IP/`).
TURN_PUBLIC_HOST=192.168.1.50
TURN_EXTERNAL_IP=192.168.1.50
TURN_INTERNAL_IP=
TURN_PORT=3478

# ─── MediaSFU ───
MEDIASOUP_ANNOUNCED_IP=192.168.1.50
MEDIASOUP_WORKERS=2
# Set true if GitHub releases are blocked; the image compiles mediasoup-worker locally.
MEDIASOUP_FORCE_LOCAL_BUILD=
