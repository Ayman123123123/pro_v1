# نهايات الأسطر: السكربتات والملفات النصية الحساسة تصل Linux بـ LF (وإلا كسر bash/nginx).
* text=auto

*.sh          text eol=lf
Dockerfile*   text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sql         text eol=lf
*.kt          text eol=lf
*.kts         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf

