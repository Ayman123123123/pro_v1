# RED Sovereign — Kamailio Dispatcher List Template
# Format: setid  destination  flags  priority  attrs  description
# Populated at runtime by docker-entrypoint.sh from DINSTAR_IPS and carrier config

# Carrier 1: Primary Dindar Gateway
1	sip:192.168.11.1:5060	0	1	weight=10;transport=udp	Primary Dinstar UC2000-VE

# Carrier 2: Secondary Dindar (if fleet > 1)
# 1	sip:192.168.11.2:5060	0	2	weight=10;transport=udp	Secondary Dinstar

# Carrier 3: Fallback SIP Trunk (external provider)
# 1	sip:trunk.provider.com:5060	0	10	weight=5;transport=udp	External SIP Trunk

# Asterisk (internal) - for inbound from carriers
2	sip:172.16.0.10:5060	0	1	weight=10;transport=udp	Asterisk Internal

# Remote worker registrar (internal)
3	sip:172.16.0.10:5060	0	1	weight=10;transport=udp	Remote Registrar