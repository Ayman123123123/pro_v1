+    private suspend fun saveSmsToRoom(msg: SmsMessageDto) {
+        dao.insertSmsMessage(
+            SmsMessageEntity(
+                id = msg.id,
+                number = msg.number,
+                content = msg.content,
+                direction = msg.direction,
+                status = msg.status,
+                createdAt = msg.createdAt,
+                read = msg.read
+            )
+        )
+    }
+
+    private suspend fun syncMessagesToRoom(number: String, messages: List<SmsMessageDto>) {
+        val entities = messages.map { msg ->
+            SmsMessageEntity(
+                id = msg.id,
+                number = msg.number,
+                content = msg.content,
+                direction = msg.direction,
+                status = msg.status,
+                createdAt = msg.createdAt,
+                read = msg.read
+            )
+        }
+        dao.insertSmsMessages(entities)
+    }
+
+    private suspend fun syncConversationsToRoom(convos: List<SmsConversationDto>) {
+        val entities = convos.map { c ->
+            SmsConversationEntity(
+                number = c.number,
+                operator = c.operator,
+                lastText = c.lastText,
+                lastTime = c.lastTime,
+                lastDirection = c.direction,
+                lastStatus = c.status,
+                unreadCount = c.unreadCount
+            )
+        }
+        entities.forEach { dao.upsertSmsConversation(it) }
+    }
+
+    private suspend fun updateConversationPreview(number: String, text: String, time: Long, direction: String, status: String) {
+        val existing = dao.getSmsConversation(number)
+        if (existing != null) {
+            dao.updateSmsConversationPreview(number, text, time, direction, status)
+        } else {
+            dao.upsertSmsConversation(
+                SmsConversationEntity(
+                    number = number,
+                    lastText = text,
+                    lastTime = time,
+                    lastDirection = direction,
+                    lastStatus = status,
+                    unreadCount = if (direction == "IN") 1 else 0
+                )
+            )
+        }
+        if (direction == "IN") dao.incrementSmsUnread(number)
+    }
 }
