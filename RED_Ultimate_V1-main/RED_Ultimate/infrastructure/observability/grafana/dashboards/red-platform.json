{
  "uid":"red-platform", "title":"RED Platform / Production Operations", "timezone":"utc", "schemaVersion":39,
  "refresh":"15s", "tags":["red","operations"],
  "panels":[
    {"type":"stat","title":"Backend up","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"up{job=\"red-backend\"}"}],"gridPos":{"x":0,"y":0,"w":4,"h":4}},
    {"type":"stat","title":"Backend p95 latency (s)","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"}],"gridPos":{"x":4,"y":0,"w":5,"h":4}},
    {"type":"stat","title":"HTTP 5xx / sec","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))"}],"gridPos":{"x":9,"y":0,"w":5,"h":4}},
    {"type":"stat","title":"JVM heap used","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"sum(jvm_memory_used_bytes{area=\"heap\"})"}],"gridPos":{"x":14,"y":0,"w":5,"h":4}},
    {"type":"timeseries","title":"HTTP throughput by status","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count[5m])) by (status)","legendFormat":"{{status}}"}],"gridPos":{"x":0,"y":4,"w":12,"h":8}},
    {"type":"timeseries","title":"Dependency availability","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"up{job=~\"red-backend|postgres|redis|mongodb|minio|media-sfu\"}","legendFormat":"{{job}}"}],"gridPos":{"x":12,"y":4,"w":12,"h":8}},
    {"type":"timeseries","title":"PostgreSQL connections","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"pg_stat_activity_count","legendFormat":"active"},{"expr":"pg_settings_max_connections","legendFormat":"max"}],"gridPos":{"x":0,"y":12,"w":12,"h":8}},
    {"type":"timeseries","title":"Redis memory / evictions","datasource":{"type":"prometheus","uid":"Prometheus"},"targets":[{"expr":"redis_memory_used_bytes","legendFormat":"used bytes"},{"expr":"rate(redis_evicted_keys_total[5m])","legendFormat":"evictions/s"}],"gridPos":{"x":12,"y":12,"w":12,"h":8}}
  ]
}
