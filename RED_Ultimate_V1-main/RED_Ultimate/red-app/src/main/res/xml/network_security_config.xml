<?xml version="1.0" encoding="utf-8"?>
<!-- RELEASE / PRODUCTION: Strict TLS-only enforcement.
     No cleartext allowed for any domain, including localhost.
     Debug LAN cleartext is provided ONLY via src/debug overlay. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow user-installed CAs only in debuggable builds (debug-overrides). 
         Release builds will still pin to system CAs only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
