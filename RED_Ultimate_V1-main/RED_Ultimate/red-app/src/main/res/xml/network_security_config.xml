<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     RELEASE / PRODUCTION — Network Security Policy
     • Default is HTTPS-only (base-config cleartext=false).
     • Cleartext HTTP is permitted ONLY for private LAN via <domain-config>
       below (10/8, 172.16/12, 192.168/16 + localhost/emulator/.local).
     • Android matches IP literals in <domain> exactly (no CIDR), so raw
       scanned LAN IPs that miss the listed entries are still gated in code:
       ServerEndpoint.isLocalCleartextHost rejects cleartext for any
       non-local host (public internet) with a literal-IP check.
     • App-level hardening still enforced in code: YounesServerSignature
       on the wire + CertificatePinner on SecureOkHttpClient when TLS is used.
     • User CAs trusted ONLY when debuggable (debug builds). Release keeps
       system-only trust anchors.
     ═══════════════════════════════════════════════════════════════════ -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext ONLY for private LAN. Public hosts fall back to base-config (HTTPS-only).
         NOTE: <domain> matches IP literals exactly — CIDR cannot be expressed here,
         so ServerEndpoint.isLocalCleartextHost (10/8, 172.16/12, 192.168/16) stays the
         authoritative range gate for discovery-scanned raw IPs. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
        <!-- Private LAN supernets (intent: 10/8, 172.16/12, 192.168/16). -->
        <domain includeSubdomains="false">10.0.0.0</domain>
        <domain includeSubdomains="false">172.16.0.0</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
    </domain-config>

    <!-- User CAs trusted only when debuggable (debug builds). Release keeps system-only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Example per-domain strict policy for RED server (when RED_TLS_PINS is set via BuildConfig):
         Add pin-set here for defense-in-depth beyond OkHttp CertificatePinner -->
</network-security-config>
