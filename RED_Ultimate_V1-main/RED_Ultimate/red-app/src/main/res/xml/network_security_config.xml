<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     RELEASE / PRODUCTION — Network Security Policy
     • Cleartext HTTP permitted: deployment is LAN-only over plain HTTP
       (nginx :8088). Discovery scans raw LAN IPs, and Android Network
       Security Config cannot match IP literals in <domain-config>, so a
       global base-config is required for the app to reach the server.
     • App-level hardening still enforced in code: YounesServerSignature
       on the wire + CertificatePinner on SecureOkHttpClient when TLS is used.
     • User CAs trusted ONLY when debuggable (debug builds). Release keeps
       system-only trust anchors.
     ═══════════════════════════════════════════════════════════════════ -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
        <!-- Optional future pinning for RED sovereign server — uncomment after generating pins:
        <pin-set expiration="2027-08-11">
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        -->
    </base-config>

    <!-- User CAs trusted only when debuggable (debug builds). Release keeps system-only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Example per-domain strict policy for RED server (when RED_TLS_PINS is set via BuildConfig):
         Add pin-set here for defense-in-depth beyond OkHttp CertificatePinner -->
</network-security-config>
