<?xml version="1.0" encoding="utf-8"?>
<!--
    🎙️ YOUNES Sovereign — Mic Button Background
    Sovereign Emerald gradient
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/yns_primary_dark">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40"
                android:startColor="@color/yns_primary"
                android:centerColor="@color/younes_emerald"
                android:endColor="@color/yns_primary_variant" />
            <stroke
                android:width="2dp"
                android:color="@color/yns_primary_light" />
        </shape>
    </item>
</ripple>
