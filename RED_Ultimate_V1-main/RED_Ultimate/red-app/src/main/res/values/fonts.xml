<?xml version="1.0" encoding="utf-8"?>
<!--
    YOUNES/RED Sovereign - Font System
    Cairo for headings, Tajawal for body - via Google Fonts Provider
    Reference: RedTheme.kt handles Compose typography
    This file provides XML fallback for legacy Views
-->
<resources>
    <!-- Cairo Font Family (Headings) -->
    <string name="font_cairo">Cairo</string>
    <string name="font_tajawal">Tajawal</string>
    <string name="font_primary">Cairo</string>
    <string name="font_secondary">Tajawal</string>

    <!-- Font weights as defined in RedTheme.kt -->
    <string name="font_weight_light">300</string>
    <string name="font_weight_regular">400</string>
    <string name="font_weight_medium">500</string>
    <string name="font_weight_semibold">600</string>
    <string name="font_weight_bold">700</string>
    <string name="font_weight_extrabold">800</string>
    <string name="font_weight_black">900</string>

    <!-- Typography scale - matches RedTheme.kt -->
    <dimen name="text_display_small">36sp</dimen>
    <dimen name="text_headline_large">30sp</dimen>
    <dimen name="text_headline_medium">25sp</dimen>
    <dimen name="text_title_large">21sp</dimen>
    <dimen name="text_body_large">17sp</dimen>
    <dimen name="text_body_medium">15sp</dimen>
    <dimen name="text_label_small">11sp</dimen>

    <!-- Arabic specific -->
    <string name="font_arabic_primary">Cairo</string>
    <string name="font_arabic_body">Tajawal</string>
    <bool name="font_supports_arabic">true</bool>
    <bool name="font_is_rtl">true</bool>
</resources>
