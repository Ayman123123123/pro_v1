<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- YOUNES Sovereign — Professional Typography System -->
    <!-- العائلة الرسمية الوحيدة: IBM Plex Sans Arabic (@font/plex_arabic)، مضمّنة
         في الحزمة عبر font/plex_arabic.xml (أوزان 400/500/600/700) — لا تُجلب من
         الشبكة. حُذفت أسماء Cairo/Tajawal الوهمية: لا ملفات لها في res/font وكان
         بقاؤها يوهم بهوية غير مطبّقة. يربط styles.xml كل android:fontFamily
         مباشرة بـ @font/plex_arabic. -->
    <string name="font_family_primary">plex_arabic</string>
    <string name="font_family_title">plex_arabic</string>
    <string name="font_family_body">plex_arabic</string>

    <!-- Font Size Tokens — Harmonized 1.25 scale -->
    <dimen name="font_size_caption">11sp</dimen>
    <dimen name="font_size_body_small">13sp</dimen>
    <dimen name="font_size_body">15sp</dimen>
    <dimen name="font_size_body_large">17sp</dimen>
    <dimen name="font_size_title">19sp</dimen>
    <dimen name="font_size_title_large">22sp</dimen>
    <dimen name="font_size_header">26sp</dimen>
    <dimen name="font_size_hero">32sp</dimen>

    <!-- Spacing — 8dp grid, consistent -->
    <dimen name="spacing_xxs">2dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="spacing_xlarge">32dp</dimen>
    <dimen name="spacing_xxlarge">48dp</dimen>

    <!-- Radius — Soft, professional, not clownish -->
    <dimen name="card_radius">20dp</dimen>
    <dimen name="card_radius_small">12dp</dimen>
    <dimen name="card_radius_large">28dp</dimen>
    <dimen name="button_radius">14dp</dimen>
    <dimen name="input_radius">16dp</dimen>
    <dimen name="avatar_radius">999dp</dimen>
    <dimen name="sheet_radius">28dp</dimen>
</resources>
