<?xml version="1.0" encoding="utf-8"?>
<!--
    YOUNES Sovereign — Official Palette, LIGHT (values/) — 2026-09-16
    الوضع الفاتح الافتراضي: خلفية لؤلؤية #F7F8FA ونص كحلي #0F1B2D.
    نظيره الداكن (الحالي سابقًا) في values-night/colors.xml بالأسماء نفسها.
    windowLightStatusBar=true هنا (أيقونات داكنة)، وfalse ليلًا.
    مزامنة مع RedTheme.kt (redLightColorScheme): primary الداكن #0A7A5E يحمل
    نصًا أبيض 5.31:1، والذهب/الكوبالت الداكنان يحملان أبيض ≥4.5:1.
    الأحمر (yns_error) لدور Danger فقط — ليس لون علامة.
-->
<resources>
    <!-- الأساسيات - الألوان الرئيسية (داكنة بما يكفي لنص أبيض AA على الفاتح) -->
    <color name="yns_primary">#0A7A5E</color>
    <color name="yns_primary_dark">#00674F</color>
    <color name="yns_primary_light">#14C79A</color>
    <color name="yns_primary_variant">#004D3A</color>

