    <!-- إفصاح الأذونات العامة وسلامة البيانات (2026-09-10): شاشة بارزة لمتطلبات الستور -->
    <string name="perm_disclosure_title">الأذونات وسلامة البيانات</string>
    <string name="perm_disclosure_sub">لماذا يطلب يونس هذه الأذونات وماذا يحدث لبياناتك</string>
    <string name="perm_disclosure_intro">يعمل يونس محلياً أولاً: رسائلك مشفرة طرفاً لطرف وتبقى على جهازك. نطلب الحد الأدنى من الأذونات، وكل إذن يُستخدم للغرض الموضح فقط، ويمكنك رفض أي إذن اختياري من إعدادات النظام.</string>
    <string name="perm_mic_title">الميكروفون</string>
    <string name="perm_mic_sub">للمكالمات الصوتية والمرئية والرسائل الصوتية فقط — لا تسجيل في الخلفية.</string>
    <string name="perm_camera_title">الكاميرا</string>
    <string name="perm_camera_sub">لمكالمات الفيديو ومسح رموز الدعوة فقط — لا تعمل إلا أثناء استخدامك لها.</string>
    <string name="perm_notif_title">الإشعارات</string>
    <string name="perm_notif_sub">لتنبيهك بالرسائل والمكالمات الواردة — يمكن كتمها لكل محادثة.</string>
    <string name="perm_bt_title">البلوتوث</string>
    <string name="perm_bt_sub">لتوجيه صوت المكالمات إلى السماعات والأجهزة القريبة فقط.</string>
    <string name="perm_phone_title">حالة الهاتف</string>
    <string name="perm_phone_sub">لإدارة صوت المكالمات عند ورود مكالمة هاتفية عادية — لا نجمع أرقاماً ولا سجلات.</string>
