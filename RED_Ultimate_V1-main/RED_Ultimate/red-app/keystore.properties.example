# Template for red-app signing configuration.
# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties is git-ignored and must NEVER be committed.
#
# Debug signing — public throwaway key wired in red-app/build.gradle.kts.
# Safe to share across the team; NOT usable for release.
debug.storeFile=signing/red-debug.p12
debug.storePassword=<debug-keystore-password>
debug.keyAlias=reddebug
debug.keyPassword=<debug-key-password>
debug.storeType=PKCS12

# Release signing — DO NOT COMMIT. Provide through env / Gradle properties
# (RED_KEYSTORE_FILE, RED_KEYSTORE_PASSWORD, RED_KEY_ALIAS, RED_KEY_PASSWORD).
# release.storeFile=path/to/release.keystore
# release.storePassword=
# release.keyAlias=
# release.keyPassword=
# release.storeType=PKCS12