# Copy to keystore.properties for local signing. NEVER commit real values.
# Debug signing (local, debug builds only)
debug.storeFile=signing/red-debug.p12
debug.storePassword=CHANGE_ME
debug.keyAlias=reddebug
debug.keyPassword=CHANGE_ME
debug.storeType=PKCS12

# Release signing (use env vars / CI secrets)
release.storeFile=
release.storePassword=
release.keyAlias=
release.keyPassword=
release.storeType=PKCS12