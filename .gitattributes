# ═══════════════════════════════════════════════════════════════
# Git Attributes — معالجة أسطر النهاية + LFS + الفروقات
# ═══════════════════════════════════════════════════════════════

# أسطر نهاية موحدة (LF) لكل النصوص — يمنع تعارض CRLF/LF عبر المنصات
* text=auto eol=lf

# ملفات نصية محددة
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.proto text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf

# ثنائيات تُعامل كـ binary (لا تحويل أسطر)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.otf   binary
*.ttf   binary
*.jar   binary
*.p12   binary
*.keystore binary
*.so    binary

# فروقات أفضل للملفات النصية
*.kt    diff=kotlin
*.kts   diff=kotlin
*.ts    diff=ts
*.tsx   diff=tsx
*.json  diff=json

# ملفات LFS للوسائط الكبيرة
*.psd filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
