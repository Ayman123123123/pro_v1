*.psd filter=lfs diff=lfs merge=lfs -text
# Shell scripts must keep LF line endings even on Windows checkouts —
# CRLF breaks the shebang (\"script.sh: not found\" inside containers).
*.sh text eol=lf
# *.jpg removed from LFS — small images (<200KB) should be normal git objects
# Large backgrounds previously tracked as LFS pointers will be migrated on next real push
