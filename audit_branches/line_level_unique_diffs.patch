+        val adminId = UUID.fromString(authentication.name)
+        val user = users.findById(UUID.fromString(userId)).orElse(null)
+            ?: return ResponseEntity.notFound().build()
+        if (hard) {
+            users.delete(user)
+        } else {
+            user.status = com.red.server.auth.model.AccountStatus.BANNED
+            users.save(user)
+        }
+
+        service.recordAudit(
