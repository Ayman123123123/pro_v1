+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Box(
+                Modifier.size(48.dp).clip(CircleShape).background(
+                    Brush.linearGradient(listOf(YounesEmerald, AqyalCyanGlow, AqyalGold))
+                ),
